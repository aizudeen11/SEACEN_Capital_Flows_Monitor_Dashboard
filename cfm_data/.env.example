# Template for .env (safe to commit). Copy this file to .env and fill in the values.

# Service-account key downloaded from Google Cloud (relative to this folder, or a full path).
GOOGLE_CREDENTIALS_FILE=credential.json

# Google Sheet IDs (the long code in the sheet's URL: docs.google.com/spreadsheets/d/<ID>/edit).
SHEET_ID_MAIN=
SHEET_ID_FSI=
SHEET_ID_SECTION2=

# Section 2 (BoP / IIP) sources, read by data_section_2.py. Full paths.
# Optional: the folder with the compiled BoP / IIP workbooks. Leave blank to use "BOP & IIP data" in this folder.
IIPBOP=
# Workbook listing the central-bank BoP / IIP items (sheets "BOP" and "IIP").
DATA=
# Mapping workbook (sheets "BoP edit", "IIP edit", "Taiwan BoP", "Taiwan IIP").
AUTOMATION=
